# ══════════════════════════════════════════════════════
#  MusicDL — Configuración de rutas y variables
#  Edita este archivo con tus rutas. No lo subas a Git.
# ══════════════════════════════════════════════════════
 
# ── Carpeta donde se guardan las canciones descargadas ──
# Usa rutas absolutas. Ejemplos:
#   Windows:  OUTPUT_DIR=C:/Users/TuNombre/Music/MusicDL
#   Linux/Mac: OUTPUT_DIR=/home/tunombre/Music/MusicDL

OUTPUT_DIR=
 
# ── Carpeta temporal (archivos en proceso, se limpian solos) ── 
TEMP_DIR=./temp # Es la carpeta por defecto dentro del proyecto, puedes cambiarla si quieres
 
# ── Carpeta para portadas subidas desde la app (portada en proceso, se limpian solo) ──
IMAGES_DIR=./images/temp # Es la carpeta por defecto dentro del proyecto, puedes cambiarla si quieres
